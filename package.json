{
  "name": "EZAgent",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "EZCloud account bridge for DeepSeek Harness: sidebar sign-in, wallet and subscription status, and an EZCloud model provider.",
  "icon": "./icon.png",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.png"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.png", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": { "optional": true }
  }
}
